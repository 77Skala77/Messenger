<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".SecureMessengerApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.SecureMessenger">
        <!--
          adjustResize: the app draws edge to edge and moves its input bar with the keyboard itself
          (the keyboard's insets), so the top bar stays and the list above the input bar shrinks, as in
          Telegram (instead of the whole screen moving up).
          configChanges: like Telegram's own activity, turning the phone or switching the system's dark
          mode does not rebuild the activity; the screens redraw for the new size and colors and keep
          everything open as it was (the open chat, a draft, the screen stack). A language change
          still rebuilds it; the app's screen stack is saved for that.
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
